rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function isValidRecord(data) {
      return data.userId == request.auth.uid
        && data.name is string && data.name.size() <= 100
        && data.principal is number
        && data.rate is number
        && data.isLend is bool
        && (data.category == 'book' || data.category == 'saved' || !('category' in data))
        && data.updatedAt is string;
    }

    // User Profile
    match /users/{userId} {
      allow read, write: if isOwner(userId);
      
      // User Records
      match /records/{recordId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidRecord(incoming()) && isValidId(recordId);
        allow update: if isOwner(userId) && isValidRecord(incoming());
        allow delete: if isOwner(userId);
      }
    }
  }
}
